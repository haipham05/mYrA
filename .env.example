# Browser-visible API origin for local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI settings. These defaults also work without a .env file.
MYRA_APP_NAME=mYrA API
MYRA_LOG_LEVEL=INFO
MYRA_CORS_ORIGINS=["http://localhost:3000"]

# Provisioned cloud resources; leave unset until available.
SUPABASE_PROJECT_REF=
DATABASE_URL=
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=
