# Browser-visible API origin for local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI settings. These defaults also work without a .env file.
MYRA_APP_NAME=mYrA API
MYRA_LOG_LEVEL=INFO
MYRA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MYRA_CORS_METHODS=["GET","POST","PUT","DELETE","OPTIONS","HEAD"]
MYRA_CORS_HEADERS=["*"]

# Database (PostgreSQL / Supabase pgvector; optional for fake/sqlite test mode)
SUPABASE_PROJECT_REF=
DATABASE_URL=

# Cloud storage (GCS; uses ADC by default)
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=

# LLM provider (DeepSeek API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Production providers fail clearly if pinned local model assets are unavailable.
# Use deterministic/simple-lexical/test only in isolated test or demo profiles.
MYRA_USE_DOCLING=true
MYRA_EMBEDDING_PROVIDER=bge-m3
MYRA_RERANKER_PROVIDER=bge
MYRA_LLM_MODE=deepseek
